{
  "appId": "store.rankr.app",
  "appName": "RankR",
  "webDir": "dist",
  "backgroundColor": "#0d0e12",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#0d0e12"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 600,
      "backgroundColor": "#0d0e12"
    },
    "StatusBar": {
      "style": "DEFAULT"
    },
    "Keyboard": {
      "resize": "native",
      "resizeOnFullScreen": true
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  }
}
